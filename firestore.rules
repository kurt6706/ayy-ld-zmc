rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- COLLECTION RULES ---

    // 1. Users
    function isValidUser(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 100 &&
             data.surname is string && data.surname.size() <= 100 &&
             data.username is string && data.username.size() <= 50;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'member' && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().role == existing().role && 
         incoming().status == existing().status)
      );
      allow delete: if isAdmin();
    }

    // 2. Events
    function isValidEvent(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && isValidEvent(incoming());
      allow update: if isAdmin() || (
        isSignedIn() && isValidEvent(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['attendeesCount'])
      );
      allow delete: if isAdmin();
    }

    // 3. Routes
    function isValidRoute(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 200;
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidRoute(incoming());
      allow delete: if isAdmin();
    }

    // 4. Blog Posts
    function isValidBlogPost(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200;
    }

    match /blogPosts/{blogPostId} {
      allow read: if true;
      allow create: if isAdmin() && isValidBlogPost(incoming());
      allow update: if isAdmin() || (
        isSignedIn() && isValidBlogPost(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasAny(['likes', 'comments']) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments'])
      );
      allow delete: if isAdmin();
    }

    // 5. User Posts
    function isValidUserPost(data) {
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 2000;
    }

    match /userPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidUserPost(incoming());
      allow update: if isSignedIn() && (isAdmin() || (existing().userId == request.auth.uid && isValidUserPost(incoming())));
      allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }

    // 6. Direct Messages
    match /directMessages/{messageId} {
      allow read, delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && (incoming().senderId == request.auth.uid || incoming().receiverId == request.auth.uid);
      allow update: if isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
    }

    // 7. Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Messages (Live Chat messages)
    function isValidMessage(data) {
      return data.senderUid == request.auth.uid &&
             data.text is string && data.text.size() <= 1000;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(incoming());
      allow update: if isSignedIn() && (existing().senderUid == request.auth.uid && isValidMessage(incoming()));
      allow delete: if isSignedIn() && (isAdmin() || existing().senderUid == request.auth.uid);
    }

    // 9. Typing State
    match /typingState/{uid} {
      allow read: if isSignedIn();
      allow write, delete: if isSignedIn() && uid == request.auth.uid;
    }

    // 10. Active Users / Presence
    match /activeUsers/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid == request.auth.uid;
    }

    // 11. Connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // 12. Gallery Items
    function isValidGalleryItem(data) {
      return data.id is string &&
             data.url is string && data.url.size() <= 1200000 &&
             data.category is string &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is string &&
             data.type is string && (data.type == 'image' || data.type == 'video');
    }

    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryItem(incoming());
      allow delete: if isAdmin();
    }

    // 13. Media Items
    match /media/{itemId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    // 14. Voice Presence
    function isValidVoicePresence(data, targetUid) {
      return data.uid == targetUid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.activeChannelId == null || data.activeChannelId is string) &&
             data.isMuted is bool &&
             data.isDeafened is bool &&
             data.isSpeaking is bool &&
             data.lastActiveTime is number &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL is string) &&
             (!('isServerMuted' in data) || data.isServerMuted is bool) &&
             (!('role' in data) || data.role is string);
    }

    match /voicePresence/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (uid == request.auth.uid || isAdmin()) && isValidVoicePresence(incoming(), uid);
      allow delete: if isSignedIn() && (uid == request.auth.uid || isAdmin());
    }

    // 15. Voice Packets
    function isValidVoicePacket(data) {
      return data.senderUid == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.channelId is string && data.channelId.size() <= 100 &&
             data.audioData is string && data.audioData.size() <= 1000000 &&
             data.timestamp is number;
    }

    match /voicePackets/{packetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVoicePacket(incoming());
      allow update, delete: if false;
    }

    // 16. Voice Channels
    function isValidVoiceChannel(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.icon is string &&
             (!('password' in data) || data.password == null || data.password is string) &&
             (!('roleRestriction' in data) || data.roleRestriction == null || data.roleRestriction is string) &&
             (!('isLocked' in data) || data.isLocked is bool) &&
             (!('isStatic' in data) || data.isStatic is bool);
    }

    match /voiceChannels/{channelId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidVoiceChannel(incoming());
      allow delete: if isAdmin();
    }
  }
}
