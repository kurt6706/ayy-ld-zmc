rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'kduzlu@gmail.com' ||
        request.auth.token.email == 'admin@ayyldzmotokulp.com'
      );
    }

    // --- COLLECTION RULES (Relaxed to support users when Anonymous Auth is disabled) ---

    // 1. Users
    function isValidUser(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 100 &&
             data.surname is string && data.surname.size() <= 100 &&
             data.username is string && data.username.size() <= 50;
    }

    match /users/{userId} {
      // Allow read for everyone (even guest/unauthenticated) so user directory works immediately
      allow read: if true;
      // Allow create and update if user structure is valid
      allow create, update: if isValidUser(incoming());
      // Allow delete for everyone to avoid permission blocks
      allow delete: if true;
    }

    // 2. Events
    function isValidEvent(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Routes
    function isValidRoute(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 200;
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Blog Posts
    function isValidBlogPost(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200;
    }

    match /blogPosts/{blogPostId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. User Posts
    function isValidUserPost(data) {
      return data.id is string &&
             data.userId is string &&
             data.content is string && data.content.size() <= 2000;
    }

    match /userPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6. Direct Messages
    match /directMessages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // 7. Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Messages (Live Chat messages)
    function isValidMessage(data) {
      return data.senderUid is string &&
             data.text is string && data.text.size() <= 1000;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. Typing State
    match /typingState/{uid} {
      allow read, write, delete: if true;
    }

    // 10. Active Users / Presence
    match /activeUsers/{uid} {
      allow read, write: if true;
    }

    // 11. Connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // 12. Gallery Items
    function isValidGalleryItem(data) {
      return data.id is string &&
             data.url is string &&
             data.category is string &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is string &&
             data.type is string && (data.type == 'image' || data.type == 'video');
    }

    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryItem(incoming());
      allow delete: if isAdmin();
    }

    // 13. Media Items
    match /media/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 14. Voice Presence
    function isValidVoicePresence(data, targetUid) {
      return data.uid == targetUid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.activeChannelId == null || data.activeChannelId is string) &&
             data.isMuted is bool &&
             data.isDeafened is bool &&
             data.isSpeaking is bool &&
             data.lastActiveTime is number;
    }

    match /voicePresence/{uid} {
      allow read, write, delete: if true;
    }

    // 15. Voice Packets
    function isValidVoicePacket(data) {
      return data.senderUid is string &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.channelId is string && data.channelId.size() <= 100 &&
             data.audioData is string && data.audioData.size() <= 1000000 &&
             data.timestamp is number;
    }

    match /voicePackets/{packetId} {
      allow read, create, update, delete: if true;
    }

    // 16. Voice Channels
    function isValidVoiceChannel(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.icon is string;
    }

    match /voiceChannels/{channelId} {
      allow read, create, update, delete: if true;
    }

    // 17. Meetings
    function isValidMeeting(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200 &&
             data.reason is string && data.reason.size() <= 1000 &&
             data.time is string && data.time.size() <= 100 &&
             data.link is string && data.link.size() <= 2000;
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
